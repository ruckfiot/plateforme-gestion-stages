      {user?.role === 'APPRENANT' && renderApprenantDashboard()}
      {user?.role === 'ENSEIGNANT' && renderEnseignantDashboard()}
      {user?.role === 'ADMIN' && renderAdminDashboard()}

    </div>
  );
};

export default Accueil;
